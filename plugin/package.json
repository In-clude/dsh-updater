{
  "name": "dsh-update-plugin",
  "version": "0.1.2",
  "type": "module",
  "description": "DSH 插件：在 DSH 内用 /update 检查并升级 dsh 本体与 profile 插件（Windows，计划任务托管，升级后自动退出与重启）",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "updater",
    "update"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/In-clude/dsh-updater.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/In-clude/dsh-updater#readme",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "checker.js",
    "worker.js",
    "scheduler.js",
    "output.js",
    "types.js",
    "cordis.patch.yml",
    "scripts",
    "locale",
    "icon.svg",
    "docs",
    "README.md"
  ],
  "scripts": {
    "prepack": "node prepack.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^24.19.4",
    "typescript": "^5.9.3"
  }
}
